{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "marketplacesouthafrica.co.za" }],
      "destination": "https://everythingmarket.co.za/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.marketplacesouthafrica.co.za" }],
      "destination": "https://everythingmarket.co.za/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/ad/:id", "destination": "/api/ad?id=:id" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
