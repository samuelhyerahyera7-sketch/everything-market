{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "marketplacesouthafrica.co.za" }],
      "destination": "https://www.everythingmarket.co.za/marketplace-south-africa",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.marketplacesouthafrica.co.za" }],
      "destination": "https://www.everythingmarket.co.za/marketplace-south-africa",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "marketplacesouthafrica.co.za" }],
      "destination": "https://www.everythingmarket.co.za/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.marketplacesouthafrica.co.za" }],
      "destination": "https://www.everythingmarket.co.za/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "rentandbuy.co.za" }],
      "destination": "https://www.everythingmarket.co.za/buy-sell/property",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.rentandbuy.co.za" }],
      "destination": "https://www.everythingmarket.co.za/buy-sell/property",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/sitemap-index.xml", "destination": "/api/sitemap-index" },
    { "source": "/sitemap-listings.xml", "destination": "/api/sitemap-listings" },
    { "source": "/sitemap-keywords.xml", "destination": "/api/sitemap-keywords" },
    { "source": "/sitemap-sellers.xml", "destination": "/api/sitemap-sellers" },
    { "source": "/store/:id", "destination": "/api/store-page?id=:id" },
    { "source": "/buy-sell/:slug", "destination": "/api/seo-page?type=category&slug=:slug" },
    { "source": "/searches/:slug", "destination": "/api/seo-page?type=popular&slug=:slug" },
    { "source": "/sell-online-south-africa", "destination": "/api/seo-page?type=static&slug=sell-online-south-africa" },
    { "source": "/post-free-ad-south-africa", "destination": "/api/seo-page?type=static&slug=post-free-ad-south-africa" },
    { "source": "/seller-growth-kit", "destination": "/api/seo-page?type=static&slug=seller-growth-kit" },
    { "source": "/safety", "destination": "/api/seo-page?type=static&slug=safety" },
    { "source": "/verified-sellers", "destination": "/api/seo-page?type=static&slug=verified-sellers" },
    { "source": "/privacy-policy", "destination": "/api/seo-page?type=static&slug=privacy-policy" },
    { "source": "/terms-and-conditions", "destination": "/api/seo-page?type=static&slug=terms-and-conditions" },
    { "source": "/paia-manual", "destination": "/api/seo-page?type=static&slug=paia-manual" },
    { "source": "/marketplace-south-africa", "destination": "/api/seo-page?type=static&slug=marketplace-south-africa" },
    { "source": "/near-me/:slug", "destination": "/api/seo-page?type=near-me&slug=:slug" },
    { "source": "/sell-my/:slug", "destination": "/api/seo-page?type=sell-my&slug=:slug" },
    { "source": "/sell/:location/:item", "destination": "/api/seo-page?type=sell-location&location=:location&item=:item" },
    { "source": "/marketplace/:location/:item", "destination": "/api/seo-page?type=marketplace-location-item&location=:location&item=:item" },
    { "source": "/marketplace-:location/:item", "destination": "/api/seo-page?type=marketplace-location-item&location=:location&item=:item" },
    { "source": "/marketplace/:slug", "destination": "/api/seo-page?type=marketplace-location&slug=:slug" },
    { "source": "/marketplace-:slug", "destination": "/api/seo-page?type=marketplace-location&slug=:slug" },
    { "source": "/city/:city/:category", "destination": "/api/seo-page?type=city-category&city=:city&category=:category" },
    { "source": "/city/:slug", "destination": "/api/seo-page?type=city&slug=:slug" },
    { "source": "/province/:province/:category", "destination": "/api/seo-page?type=province-category&province=:province&category=:category" },
    { "source": "/province/:slug", "destination": "/api/seo-page?type=province&slug=:slug" },
    { "source": "/ad/:id", "destination": "/api/ad?id=:id" },
    { "source": "/api/verify/phone-start",        "destination": "/api/verify-phone-start" },
    { "source": "/api/verify/biometric-challenge","destination": "/api/verify-biometric-challenge" },
    { "source": "/api/verify/biometric-submit",   "destination": "/api/verify-biometric-submit" },
    { "source": "/api/verify/biometric-poll",     "destination": "/api/verify-biometric-poll" },
    { "source": "/api/verify/status",             "destination": "/api/verify-status" },
    { "source": "/api/whatsapp-webhook",          "destination": "/api/whatsapp-webhook" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
