# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# Meta WhatsApp Cloud API
META_WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
META_WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
META_WHATSAPP_BUSINESS_NUMBER=27XXXXXXXXXX
META_WEBHOOK_VERIFY_TOKEN=choose-a-random-string
META_APP_SECRET=your-meta-app-secret

# Biometrical-Verify service (self-hosted Docker — see README)
BIOMETRIC_API_URL=https://your-biometric-service.example.com
BIOMETRIC_JWT_SECRET=choose-a-long-random-secret

# Push notifications (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
